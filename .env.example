DATABASE_URL="postgresql://user:password@host:5432/leaflife?schema=public"

NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary — used for product image uploads in the admin panel.
# Get these from your Cloudinary dashboard (cloudinary.com, free tier is fine).
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Resend — used to send email verification links on registration.
# Sign up free at resend.com. For testing, "onboarding@resend.dev" works
# as EMAIL_FROM without any domain setup; for production, verify your own
# sending domain in Resend first.
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="LEAFLIFE <onboarding@resend.dev>"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# Razorpay — added in the checkout phase. Never expose KEY_SECRET or
# WEBHOOK_SECRET to the client; only NEXT_PUBLIC_RAZORPAY_KEY_ID is public.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-secret"
RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
