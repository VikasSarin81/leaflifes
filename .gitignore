# dependencies
/node_modules

# next.js build output
/.next/
/out/

# environment files — NEVER commit real secrets
.env
.env.local
.env*.local

# API key exports (Razorpay/Cloudinary sometimes offer CSV downloads —
# never let these sit in the repo)
*.csv
rzp-key*

# Netlify build artifacts — never commit these, they can contain bundled secrets
.netlify/

# Personal notes files that sometimes end up holding real credentials —
# never let these into the repo
adminuser.txt
*-key*.csv

# misc
.DS_Store
*.log
