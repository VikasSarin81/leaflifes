# dependencies
/node_modules

# next.js build output
/.next/
/out/

# environment files — NEVER commit real secrets
.env
.env.local
.env*.local

# API key exports (Razorpay/Cloudinary sometimes offer CSV downloads —
# never let these sit in the repo)
*.csv
rzp-key*

# Netlify build artifacts — never commit these, they can contain bundled secrets
.netlify/

# misc
.DS_Store
*.log
